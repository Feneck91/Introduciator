<?xml version="1.0"?>
<ruleset name="Introduciator phpBB Extension Coding Standard">
    <description>phpBB coding rules for the Introduciator extension.</description>

    <file>Ext/feneck91/introduciator</file>
    <arg name="extensions" value="php" />
    <arg name="encoding" value="utf-8" />

    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <rule ref="vendor/senky/phpbb-coding-standard/ruleset.xml" />
</ruleset>
